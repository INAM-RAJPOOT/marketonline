{% comment %}
  Product media gallery with images, video, and 3D.
  Accepts:
  - product: {Object}
  - section: {Object}
{% endcomment %}

{%- liquid
  assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media | default: product.media.first
  assign enable_zoom = section.settings.enable_image_zoom
-%}

<div
  class="product__media-gallery"
  data-product-media
  data-enable-zoom="{{ enable_zoom }}"
>
  <script type="application/json" id="product-media-json-{{ section.id }}">
    [
      {%- for media in product.media -%}
        {
          "id": {{ media.id }},
          "media_type": {{ media.media_type | json }},
          "alt": {{ media.alt | json }},
          "preview_image": {{ media.preview_image | image_url: width: 120 | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>

  <div
    class="product__media-main{% if enable_zoom %} product__media-main--zoom{% endif %}"
    id="product-media-viewer"
  >
    {%- if product.media.size > 0 -%}
      {%- for media in product.media -%}
        {%- if forloop.first -%}
          {%- assign media_loading = 'eager' -%}
        {%- else -%}
          {%- assign media_loading = 'lazy' -%}
        {%- endif -%}
        <div
          class="product__media-item{% if media.id == featured_media.id %} is-active{% endif %}"
          data-media-id="{{ media.id }}"
          data-media-type="{{ media.media_type }}"
          {% unless media.id == featured_media.id %}hidden{% endunless %}
        >
          {% render 'product-media', media: media, loading: media_loading %}
        </div>
      {%- endfor -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'product__media-placeholder' }}
    {%- endif -%}
  </div>

  {%- if product.media.size > 1 -%}
    <div class="product__media-thumbnails" role="list" aria-label="{{ 'products.media.gallery' | t }}">
      {%- for media in product.media -%}
        <button
          type="button"
          class="product__thumbnail{% if media.id == featured_media.id %} product__thumbnail--active{% endif %}"
          data-media-id="{{ media.id }}"
          data-media-type="{{ media.media_type }}"
          aria-label="{{ media.alt | default: product.title | escape }}"
          role="listitem"
        >
          {{
            media.preview_image
            | image_url: width: 120
            | image_tag:
              loading: 'lazy',
              class: 'product__thumbnail-image',
              alt: '',
              width: 120,
              height: 120
          }}
          {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
            <span class="product__thumbnail-badge" aria-hidden="true">▶</span>
          {%- elsif media.media_type == 'model' -%}
            <span class="product__thumbnail-badge" aria-hidden="true">3D</span>
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
