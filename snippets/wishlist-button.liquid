{% comment %}
  Renders a wishlist toggle button.

  Accepts:
  - product_handle: {String} Product handle (required)
  - class: {String} Additional CSS class (optional)
  - show_label: {Boolean} Show text label (optional)
{% endcomment %}

{%- liquid
  assign show_label = show_label | default: false, allow_false: true
-%}

{%- if settings.enable_wishlist and product_handle != blank -%}
  <button
    type="button"
    class="wishlist-button{% if class %} {{ class }}{% endif %}"
    data-wishlist-toggle
    data-product-handle="{{ product_handle }}"
    aria-pressed="false"
    aria-label="{{ 'wishlist.add' | t }}"
  >
    <svg class="wishlist-button__icon wishlist-button__icon--outline" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
    </svg>
    <svg class="wishlist-button__icon wishlist-button__icon--filled" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
    </svg>
    {%- if show_label -%}
      <span class="wishlist-button__label" data-wishlist-label>{{ 'wishlist.add' | t }}</span>
    {%- else -%}
      <span class="visually-hidden">{{ 'wishlist.add' | t }}</span>
    {%- endif -%}
  </button>
{%- endif -%}
