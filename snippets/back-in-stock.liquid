{% comment %}
  Email capture when the selected variant is unavailable.
  Accepts:
  - product: {Object}
  - block: {Object}
{% endcomment %}
{%- assign variant = product.selected_or_first_available_variant -%}
<div
  class="back-in-stock"
  data-back-in-stock
  {% if variant.available %}hidden{% endif %}
  {{ block.shopify_attributes }}
>
  <p class="back-in-stock__title">{{ 'products.back_in_stock' | t }}</p>
  {%- form 'contact', class: 'back-in-stock__form' -%}
    {%- if form.posted_successfully? -%}
      <p class="back-in-stock__success" role="status">{{ 'products.back_in_stock_success' | t }}</p>
    {%- endif -%}
    {%- if form.errors -%}
      <div class="back-in-stock__error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <input type="hidden" name="contact[tags]" value="back-in-stock">
    <input type="hidden" name="contact[body]" data-bis-body value="{{ 'products.back_in_stock_body' | t: product: product.title, variant: variant.title }}">
    <label class="visually-hidden" for="BackInStock-{{ block.id }}">{{ 'products.back_in_stock_email' | t }}</label>
    <input
      type="email"
      id="BackInStock-{{ block.id }}"
      name="contact[email]"
      placeholder="{{ 'products.back_in_stock_email' | t }}"
      autocomplete="email"
      required
    >
    <button type="submit" class="button button--secondary">{{ 'products.back_in_stock_submit' | t }}</button>
  {%- endform -%}
</div>
