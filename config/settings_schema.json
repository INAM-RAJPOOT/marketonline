[
  {
    "name": "theme_info",
    "theme_name": "MarketOnline",
    "theme_version": "1.2.0",
    "theme_author": "ANAM UL HAQ",
    "theme_documentation_url": "https://github.com/INAM-RAJPOOT/marketonline#readme",
    "theme_support_url": "https://github.com/INAM-RAJPOOT/marketonline/issues"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 100,
        "max": 150,
        "step": 5,
        "unit": "%",
        "label": "Font size scale",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "label": "Font",
        "default": "work_sans_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 100,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Font size scale",
        "default": 100
      }
    ]
  },
