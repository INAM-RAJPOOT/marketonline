      {
        "type": "header",
        "content": "Inputs and forms"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "Input corner radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          { "value": "90rem", "label": "t:options.page_width.narrow" },
          { "value": "110rem", "label": "t:options.page_width.wide" }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Space between sections",
        "default": 0
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "range",
        "id": "buttons_border_width",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "Border width",
        "default": 1
      },
      {
        "type": "range",
        "id": "buttons_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Corner radius",
        "default": 0
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 100
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "32 x 32px .png recommended"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "header",
        "content": "Social media accounts"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X (Twitter)",
        "info": "https://twitter.com/shopify"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "info": "https://facebook.com/shopify"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "info": "https://pinterest.com/shopify"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/shopify"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "info": "https://tiktok.com/@shopify"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube",
        "info": "https://youtube.com/shopify"
      }
    ]
  },
  {
    "name": "Search behavior",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "default": true,
        "label": "Enable predictive search"
      }
    ]
  },
  {
    "name": "Cart drawer",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer_show_upsells",
        "default": true,
        "label": "Show recommended products in cart drawer"
      },
      {
        "type": "range",
        "id": "cart_drawer_upsells_limit",
        "min": 2,
        "max": 4,
        "step": 1,
        "label": "Number of recommendations",
        "default": 3
      }
    ]
  },
  {
    "name": "Currency format",
    "settings": [
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "default": false,
        "label": "Show currency codes"
      }
    ]
  },
  {
    "name": "Product reviews",
    "settings": [
      {
        "type": "select",
        "id": "reviews_provider",
        "label": "Reviews provider",
        "default": "standard",
        "options": [
          { "value": "standard", "label": "Shopify standard metafields" },
          { "value": "judgeme", "label": "Judge.me" },
          { "value": "app_block", "label": "App blocks only" }
        ],
        "info": "Install Judge.me from the Shopify App Store before selecting Judge.me"
      },
      {
        "type": "checkbox",
        "id": "show_product_rating",
        "default": true,
        "label": "Show star ratings"
      },
      {
        "type": "checkbox",
        "id": "show_product_rating_on_cards",
        "default": true,
        "label": "Show ratings on product cards"
      },
      {
        "type": "checkbox",
        "id": "show_product_rating_zero",
        "default": false,
        "label": "Show empty ratings when no reviews exist"
      }
    ]
  },
  {
    "name": "Wishlist",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_wishlist",
        "default": true,
        "label": "Enable wishlist"
      },
      {
        "type": "page",
        "id": "wishlist_page",
        "label": "Wishlist page",
        "info": "Create a page and assign the \"wishlist\" template"
      }
    ]
  },
  {
    "name": "Localization",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_country_selector",
        "default": true,
        "label": "Enable country/region selector"
      },
      {
        "type": "checkbox",
        "id": "enable_language_selector",
        "default": true,
        "label": "Enable language selector"
      },
      {
        "type": "checkbox",
        "id": "localization_in_header",
        "default": true,
        "label": "Show selectors in header"
      },
      {
        "type": "checkbox",
        "id": "localization_in_footer",
        "default": false,
        "label": "Show selectors in footer"
      }
    ]
  },
  {
    "name": "Cart options",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_cart_note",
        "default": true,
        "label": "Enable order notes"
      },
      {
        "type": "checkbox",
        "id": "enable_gift_wrap",
        "default": true,
        "label": "Enable gift wrapping"
      },
      {
        "type": "product",
        "id": "gift_wrap_product",
        "label": "Gift wrap product",
        "info": "Optional paid gift-wrap product. Leave empty to save gift wrap as a cart note only."
      }
    ]
  },
  {
    "name": "Age verification",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_age_verifier",
        "default": false,
        "label": "Enable age verifier"
      },
      {
        "type": "range",
        "id": "age_verifier_minimum",
        "min": 18,
        "max": 21,
        "step": 1,
        "label": "Minimum age",
        "default": 18
      }
    ]
  },
  {
    "name": "Promo popup",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_promo_popup",
        "default": true,
        "label": "Enable promo popup"
      },
      {
        "type": "image_picker",
        "id": "promo_popup_image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "promo_popup_heading",
        "label": "Heading",
        "default": "Get 10% off"
      },
      {
        "type": "richtext",
        "id": "promo_popup_text",
        "label": "Text",
        "default": "<p>Join the list for new arrivals and private offers.</p>"
      },
      {
        "type": "text",
        "id": "promo_popup_button",
        "label": "Button label",
        "default": "Subscribe"
      },
      {
        "type": "range",
        "id": "promo_popup_delay",
        "min": 1,
        "max": 15,
        "step": 1,
        "unit": "s",
        "label": "Delay",
        "default": 4
      }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "default": true,
        "label": "Enable animations",
        "info": "Page fade, scroll reveal, and cart icon motion. Honors reduced-motion preferences."
      },
      {
        "type": "checkbox",
        "id": "enable_back_to_top",
        "default": true,
        "label": "Show back to top button"
      }
    ]
  }
]
