<section class="customer section-spacing" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="customer__header">
      <h1 class="customer__title">{{ 'customers.reset_password.title' | t }}</h1>
      <p class="customer__subtitle">{{ 'customers.reset_password.subtext' | t }}</p>
    </div>

    <div class="customer__card">
      {%- form 'reset_customer_password', class: 'customer__form' -%}
        {%- if form.errors -%}
          <div class="customer__errors" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="customer__field">
          <label for="reset-password">{{ 'customers.reset_password.password' | t }}</label>
          <input type="password" id="reset-password" name="customer[password]" class="customer__input" autocomplete="new-password" required>
        </div>

        <div class="customer__field">
          <label for="reset-password-confirm">{{ 'customers.reset_password.password_confirm' | t }}</label>
          <input type="password" id="reset-password-confirm" name="customer[password_confirmation]" class="customer__input" autocomplete="new-password" required>
        </div>

        <button type="submit" class="button button--primary">{{ 'customers.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "settings": []
}
{% endschema %}
