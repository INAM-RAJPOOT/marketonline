<section
  class="recently-viewed section-spacing"
  id="shopify-section-{{ section.id }}"
  data-recently-viewed
  data-limit="{{ section.settings.products_to_show }}"
  data-current="{% if product %}{{ product.handle }}{% endif %}"
  hidden
>
  <div class="page-width">
    <h2 class="recently-viewed__heading">{{ section.settings.heading }}</h2>
    <ul class="recently-viewed__grid list-unstyled" role="list" data-recently-viewed-grid></ul>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "class": "section-recently-viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Recently viewed"
    }
  ]
}
{% endschema %}
