<section class="lookbook section-spacing" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="lookbook__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="lookbook__intro rte">{{ section.settings.text }}</div>
    {%- endif -%}
    <div class="lookbook__stage">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            loading: 'lazy',
            widths: '600, 900, 1200, 1600, 2000',
            sizes: '100vw',
            class: 'lookbook__image',
            alt: section.settings.image.alt | default: section.settings.heading | escape
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook__placeholder' }}
      {%- endif -%}

      {%- for block in section.blocks -%}
        <div
          class="lookbook__hotspot"
          style="--x: {{ block.settings.horizontal }}%; --y: {{ block.settings.vertical }}%;"
          {{ block.shopify_attributes }}
        >
          <button
            type="button"
            class="lookbook__dot"
            aria-expanded="false"
            aria-controls="Hotspot-{{ block.id }}"
            data-hotspot
          >
            <span class="visually-hidden">{{ block.settings.heading | default: block.settings.product.title }}</span>
          </button>
          <div id="Hotspot-{{ block.id }}" class="lookbook__card" hidden>
            {%- if block.settings.product != blank -%}
              <a href="{{ block.settings.product.url }}" class="lookbook__product">
                {%- if block.settings.product.featured_image -%}
                  {{
                    block.settings.product.featured_image
                    | image_url: width: 160
                    | image_tag: loading: 'lazy', alt: block.settings.product.title, width: 64, height: 64
                  }}
                {%- endif -%}
                <span>
                  <strong>{{ block.settings.heading | default: block.settings.product.title }}</strong>
                  <span>{{ block.settings.product.price | money }}</span>
                </span>
              </a>
            {%- else -%}
              <p class="lookbook__card-title">{{ block.settings.heading }}</p>
              {%- if block.settings.text != blank -%}
                <p class="lookbook__card-text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.link != blank and block.settings.link_label != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook hotspots",
  "tag": "section",
  "class": "section-lookbook",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the look"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tag products or details on a lookbook image. Tap a hotspot to open it.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "range",
          "id": "horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 40
        },
        {
          "type": "range",
          "id": "vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 45
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Featured piece"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook hotspots",
      "blocks": [
        { "type": "hotspot", "settings": { "horizontal": 32, "vertical": 40, "heading": "Jacket" } },
        { "type": "hotspot", "settings": { "horizontal": 62, "vertical": 68, "heading": "Sneakers" } }
      ]
    }
  ]
}
{% endschema %}
