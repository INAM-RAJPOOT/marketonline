{%- style -%}
  #shopify-section-{{ section.id }} {
    --hero-height: {{ section.settings.section_height }}vh;
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --content-align: {{ section.settings.content_alignment }};
  }
{%- endstyle -%}

{%- assign slide_count = section.blocks.size -%}
{%- if slide_count == 0 -%}
  {%- assign slide_count = 1 -%}
{%- endif -%}

<section
  class="hero hero-carousel"
  id="shopify-section-{{ section.id }}"
  aria-roledescription="carousel"
  aria-label="Featured promotions"
  tabindex="0"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  data-slide-count="{{ slide_count }}"
>
  <div class="hero-carousel__slides">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div
          class="hero-carousel__slide{% if forloop.first %} is-active{% endif %}"
          data-slide
          role="group"
          aria-roledescription="slide"
          aria-label="Slide {{ forloop.index }} of {{ section.blocks.size }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <div class="hero__media">
              {%- if forloop.first -%}
                {{
                  block.settings.image
                  | image_url: width: 1920
                  | image_tag:
                    loading: 'eager',
                    fetchpriority: 'high',
                    sizes: '100vw',
                    widths: '375, 550, 750, 1100, 1500, 1780, 2000',
                    class: 'hero__image',
                    alt: block.settings.image.alt | default: block.settings.heading | escape
                }}
              {%- else -%}
                {{
                  block.settings.image
                  | image_url: width: 1920
                  | image_tag:
                    loading: 'lazy',
                    sizes: '100vw',
                    widths: '375, 550, 750, 1100, 1500, 1780, 2000',
                    class: 'hero__image',
                    alt: block.settings.image.alt | default: block.settings.heading | escape
                }}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="hero__media hero__media--placeholder">
              {%- liquid
                assign placeholder_mod = forloop.index | modulo: 2
                if placeholder_mod == 0
                  assign hero_placeholder = 'lifestyle-2'
                else
                  assign hero_placeholder = 'lifestyle-1'
                endif
              -%}
              {{ hero_placeholder | placeholder_svg_tag: 'hero__placeholder-svg' }}
            </div>
          {%- endif -%}

          <div class="hero__overlay" aria-hidden="true"></div>

          <div class="hero__content page-width">
            <div class="hero__content-inner">
              {%- if block.settings.subheading != blank -%}
                <p class="hero__subheading">{{ block.settings.subheading }}</p>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h2 class="hero__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <p class="hero__text">{{ block.settings.text }}</p>
              {%- endif -%}

              {%- if block.settings.button_label != blank -%}
                <div class="hero__buttons">
                  <a
                    href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
                    class="button button--primary button--large"
                    {% if block.settings.button_link == blank %}aria-disabled="true"{% endif %}
                  >
                    {{ block.settings.button_label }}
                  </a>

                  {%- if block.settings.button_label_2 != blank -%}
                    <a
                      href="{{ block.settings.button_link_2 | default: routes.all_products_collection_url }}"
                      class="button button--secondary button--large"
                    >
                      {{ block.settings.button_label_2 }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div
        class="hero-carousel__slide is-active"
        data-slide
        role="group"
        aria-roledescription="slide"
        aria-label="Slide 1 of 1"
      >
        {%- if section.settings.image != blank -%}
          <div class="hero__media">
            {{
              section.settings.image
              | image_url: width: 1920
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                sizes: '100vw',
                widths: '375, 550, 750, 1100, 1500, 1780, 2000',
                class: 'hero__image',
                alt: section.settings.image.alt | default: section.settings.heading | escape
            }}
          </div>
        {%- else -%}
          <div class="hero__media hero__media--placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder-svg' }}
          </div>
        {%- endif -%}

        <div class="hero__overlay" aria-hidden="true"></div>

        <div class="hero__content page-width">
          <div class="hero__content-inner">
            {%- if section.settings.subheading != blank -%}
              <p class="hero__subheading">{{ section.settings.subheading }}</p>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h2 class="hero__heading">{{ section.settings.heading }}</h2>
            {%- endif -%}

            {%- if section.settings.text != blank -%}
              <p class="hero__text">{{ section.settings.text }}</p>
            {%- endif -%}

            {%- if section.settings.button_label != blank -%}
              <div class="hero__buttons">
                <a
                  href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
                  class="button button--primary button--large"
                >
                  {{ section.settings.button_label }}
                </a>

                {%- if section.settings.button_label_2 != blank -%}
                  <a
                    href="{{ section.settings.button_link_2 | default: routes.all_products_collection_url }}"
                    class="button button--secondary button--large"
                  >
                    {{ section.settings.button_label_2 }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if slide_count > 1 -%}
    {%- if section.settings.show_arrows -%}
      <button
        type="button"
        class="hero-carousel__arrow hero-carousel__arrow--prev"
        aria-label="Previous slide"
        data-carousel-prev
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
      <button
        type="button"
        class="hero-carousel__arrow hero-carousel__arrow--next"
        aria-label="Next slide"
        data-carousel-next
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
    {%- endif -%}

    {%- if section.settings.show_dots -%}
      <div class="hero-carousel__dots" role="tablist" aria-label="Choose slide">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="hero-carousel__dot{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-label="Go to slide {{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-carousel-dot="{{ forloop.index0 }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

<style>
  .hero {
    position: relative;
    min-height: var(--hero-height);
    overflow: hidden;
    background: rgb(var(--color-base-background-2));
  }

  .hero-carousel__slides {
    position: relative;
    min-height: var(--hero-height);
  }

  .hero-carousel__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    opacity: 0;
    z-index: 0;
    pointer-events: none;
    transition: opacity 0.8s ease-in-out;
  }

  .hero-carousel__slide.is-active {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
  }

  .hero-carousel__slide.is-active .hero__content-inner {
    animation: heroContentIn 0.8s ease-out both;
  }

  @keyframes heroContentIn {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__image,
  .hero__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero__media--placeholder {
    background: rgb(var(--color-base-background-2));
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, var(--overlay-opacity));
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: 6rem;
    padding-bottom: 6rem;
    display: flex;
    justify-content: var(--content-align);
  }

  .hero__content-inner {
    max-width: 64rem;
  }

  .hero__subheading {
    font-size: 1.4rem;
    font-weight: var(--font-body-weight-bold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 1.5rem;
  }

  .hero__heading {
    font-size: clamp(3.2rem, 6vw, 7.2rem);
    line-height: 1.1;
    margin: 0 0 2rem;
    color: #ffffff;
    word-break: break-word;
  }

  .hero__text {
    font-size: 1.8rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 3rem;
    max-width: 48rem;
  }

  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    align-items: center;
  }

  .button--large {
    padding: 1.6rem 3.2rem;
    font-size: 1.5rem;
  }

  .hero .button--secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.2rem 2rem;
    background: transparent;
    color: #ffffff;
    font-size: 1.4rem;
    font-family: var(--font-body-family);
    font-weight: var(--font-body-weight-bold);
    border: 2px solid rgba(255, 255, 255, 0.7);
    border-radius: var(--buttons-radius);
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
    white-space: nowrap;
  }

  .hero .button--secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: #ffffff;
    text-decoration: none;
  }

  .hero-carousel__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.8rem;
    height: 4.8rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background 0.2s, transform 0.2s;
  }

  .hero-carousel__arrow:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .hero-carousel__arrow--prev { left: 2rem; }
  .hero-carousel__arrow--next { right: 2rem; }

  .hero-carousel__dots {
    position: absolute;
    bottom: 2.4rem;
    left: 50%;
    z-index: 3;
    transform: translateX(-50%);
    display: flex;
    gap: 0.8rem;
  }

  .hero-carousel__dot {
    width: 1rem;
    height: 1rem;
    padding: 0;
    border: 2px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }

  .hero-carousel__dot.is-active {
    background: #ffffff;
    border-color: #ffffff;
    transform: scale(1.15);
  }

  .hero-carousel__dot:hover {
    border-color: #ffffff;
  }

  @media (max-width: 768px) {
    .hero__heading {
      font-size: clamp(2.8rem, 8vw, 4.8rem);
    }
    .hero__text {
      font-size: 1.6rem;
    }
    .hero__content {
      justify-content: flex-start;
    }
    .hero-carousel__arrow {
      width: 4rem;
      height: 4rem;
    }
    .hero-carousel__arrow--prev { left: 1rem; }
    .hero-carousel__arrow--next { right: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-carousel__slide {
      transition: none;
    }
    .hero-carousel__slide.is-active .hero__content-inner {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "Hero carousel",
  "tag": "section",
  "class": "section-hero",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "section_height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Section height",
      "default": 80
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 40
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 5,
      "max": 20,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dot navigation",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "New collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Built for the bold."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Shop the latest arrivals — curated for those who lead."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button 1 label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button 1 link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Button 2 label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Button 2 link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero carousel",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "subheading": "New collection",
            "heading": "Built for the bold.",
            "text": "Shop the latest arrivals — curated for those who lead.",
            "button_label": "Shop now",
            "button_label_2": "Learn more"
          }
        },
        {
          "type": "slide",
          "settings": {
            "subheading": "Summer sale",
            "heading": "Up to 40% off",
            "text": "Limited time only — grab your favorites before they're gone.",
            "button_label": "Shop sale",
            "button_label_2": ""
          }
        },
        {
          "type": "slide",
          "settings": {
            "subheading": "Just dropped",
            "heading": "The essentials edit",
            "text": "Timeless pieces designed to elevate your everyday.",
            "button_label": "Explore now",
            "button_label_2": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
