{%- paginate collection.products by section.settings.products_per_page -%}
<section
  class="collection section-spacing"
  id="shopify-section-{{ section.id }}"
  data-collection-section="{{ section.id }}"
>
  <div class="page-width">
    {% render 'breadcrumbs' %}

    {%- comment -%} Collection Header {%- endcomment -%}
    <div class="collection__header">
      {%- if collection.image -%}
        <div class="collection__banner">
          {{
            collection.image
            | image_url: width: 1500
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '100vw',
              widths: '375, 750, 1100, 1500',
              class: 'collection__banner-image',
              alt: collection.image.alt | default: collection.title | escape
          }}
        </div>
      {%- endif -%}

      <div class="collection__header-content">
        <h1 class="collection__title">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <div class="collection__description rte">{{ collection.description }}</div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Toolbar: Count + Sort + Filter toggle {%- endcomment -%}
    <div class="collection__toolbar">
      <p class="collection__count" id="CollectionProductCount" aria-live="polite">
        {{ 'collections.product_count' | t: count: collection.products_count }}
      </p>

      <div class="collection__toolbar-right">
        {%- if section.settings.enable_filtering -%}
          <button
            class="collection__filter-toggle"
            aria-expanded="false"
            aria-controls="collection-filters"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/>
            </svg>
            {{ 'collections.filter' | t }}
          </button>
        {%- endif -%}

        {%- if section.settings.enable_sorting -%}
          <div class="collection__sort">
            <label for="sort-by-{{ section.id }}" class="collection__sort-label">{{ 'collections.sort' | t }}:</label>
            <select
              id="sort-by-{{ section.id }}"
              name="sort_by"
              class="collection__sort-select"
              aria-label="Sort products"
            >
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              {%- for option in collection.sort_options -%}
                <option
                  value="{{ option.value }}"
                  {% if option.value == sort_by %}selected{% endif %}
                >
                  {{ option.name }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="collection__layout">

      {%- comment -%} Filters Sidebar {%- endcomment -%}
      {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
        <div class="collection__filters" id="collection-filters" aria-hidden="true">
          <div id="CollectionFiltersForm">
          <div class="collection__filters-header">
            <h2 class="collection__filters-title">{{ 'collections.filters' | t }}</h2>
            <button class="collection__filters-close" aria-label="Close filters">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>

          {%- for filter in collection.filters -%}
            <details class="collection__filter-group" open>
              <summary class="collection__filter-heading">
                {{ filter.label }}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </summary>

              <div class="collection__filter-options">
                {%- case filter.type -%}
                  {%- when 'list' -%}
                    <ul class="collection__filter-list list-unstyled" role="list">
                      {%- for value in filter.values -%}
                        <li class="collection__filter-item">
                          <label class="collection__filter-label">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                              class="collection__filter-checkbox"
                            >
                            <span class="collection__filter-value">{{ value.label }}</span>
                            <span class="collection__filter-count">({{ value.count }})</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>

                  {%- when 'price_range' -%}
                    <div class="collection__filter-price">
                      <div class="collection__filter-price-inputs">
                        <div class="collection__filter-price-field">
                          <label for="filter-price-min-{{ section.id }}">{{ 'collections.min_price' | t }}</label>
                          <input
                            type="number"
                            id="filter-price-min-{{ section.id }}"
                            name="{{ filter.min_value.param_name }}"
                            value="{{ filter.min_value.value | divided_by: 100 }}"
                            placeholder="0"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100 }}"
                            class="collection__filter-price-input"
                          >
                        </div>
                        <span class="collection__filter-price-separator">—</span>
                        <div class="collection__filter-price-field">
                          <label for="filter-price-max-{{ section.id }}">{{ 'collections.max_price' | t }}</label>
                          <input
                            type="number"
                            id="filter-price-max-{{ section.id }}"
                            name="{{ filter.max_value.param_name }}"
                            value="{{ filter.max_value.value | divided_by: 100 }}"
                            placeholder="{{ filter.range_max | divided_by: 100 }}"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100 }}"
                            class="collection__filter-price-input"
                          >
                        </div>
                      </div>
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}

          <div class="collection__filter-actions">
            <button type="button" class="button button--primary collection__filter-apply">{{ 'collections.apply_filters' | t }}</button>
            <a href="{{ collection.url }}" class="collection__filter-clear" data-collection-clear>{{ 'collections.clear_all' | t }}</a>
          </div>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} Product Grid {%- endcomment -%}
      <div class="collection__products" id="CollectionProducts">
        <div id="CollectionAjaxContent">
          {% render 'collection-product-grid', collection: collection, section: section, paginate: paginate %}
        </div>
      </div>

    </div>
  </div>
</section>
{%- endpaginate -%}

<style>
  .collection__banner {
    margin-bottom: 3rem;
    border-radius: 12px;
    overflow: hidden;
    max-height: 32rem;
  }

  .collection__banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collection__header-content { margin-bottom: 3rem; }

  .collection__title {
    font-size: clamp(2.8rem, 4vw, 4.8rem);
    margin: 0 0 1.2rem;
  }

  .collection__description {
    font-size: 1.5rem;
    line-height: 1.7;
    color: rgba(var(--color-base-text-1), 0.75);
    max-width: 72rem;
  }

  .collection__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.6rem 0;
    border-top: 1px solid rgba(var(--color-base-text-1), 0.1);
    border-bottom: 1px solid rgba(var(--color-base-text-1), 0.1);
    margin-bottom: 3rem;
    gap: 1.6rem;
    flex-wrap: wrap;
  }

  .collection__count {
    font-size: 1.4rem;
    color: rgba(var(--color-base-text-1), 0.6);
    margin: 0;
  }

  .collection__toolbar-right {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .collection__filter-toggle {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.6rem;
    font-size: 1.4rem;
    font-family: var(--font-body-family);
    border: 1.5px solid rgba(var(--color-base-text-1), 0.3);
    border-radius: var(--buttons-radius);
    background: transparent;
    color: rgb(var(--color-base-text-1));
    cursor: pointer;
    transition: background 0.2s;
  }

  .collection__filter-toggle:hover {
    background: rgba(var(--color-base-text-1), 0.05);
  }

  .collection__sort {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .collection__sort-label {
    font-size: 1.4rem;
    color: rgba(var(--color-base-text-1), 0.7);
    white-space: nowrap;
  }

  .collection__sort-select {
    font-size: 1.4rem;
    font-family: var(--font-body-family);
    color: rgb(var(--color-base-text-1));
    background: transparent;
    border: 1.5px solid rgba(var(--color-base-text-1), 0.3);
    border-radius: var(--inputs-radius);
    padding: 0.8rem 1.2rem;
    cursor: pointer;
  }

  .collection__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  .collection__layout--with-filters {
    grid-template-columns: 28rem 1fr;
  }

  .collection__filters {
    background: rgb(var(--color-base-background-2));
    border-radius: 12px;
    padding: 2.4rem;
    height: fit-content;
    position: sticky;
    top: 10rem;
  }

  .collection__filters[aria-hidden="true"] { display: none; }
  .collection__filters[aria-hidden="false"] { display: block; }

  .collection__filters-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .collection__filters-title {
    font-size: 1.8rem;
    margin: 0;
  }

  .collection__filters-close {
    background: none;
    border: none;
    cursor: pointer;
    color: rgb(var(--color-base-text-1));
    padding: 4px;
  }

  .collection__filter-group {
    border-bottom: 1px solid rgba(var(--color-base-text-1), 0.1);
    padding: 1.6rem 0;
  }

  .collection__filter-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.4rem;
    font-weight: var(--font-body-weight-bold);
    cursor: pointer;
    list-style: none;
    margin-bottom: 0;
  }

  .collection__filter-heading::-webkit-details-marker { display: none; }

  details[open] .collection__filter-heading { margin-bottom: 1.2rem; }

  .collection__filter-list { margin-top: 1rem; }

  .collection__filter-item { margin-bottom: 0.8rem; }

  .collection__filter-label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.4rem;
    cursor: pointer;
  }

  .collection__filter-checkbox { cursor: pointer; width: 1.6rem; height: 1.6rem; }

  .collection__filter-count {
    color: rgba(var(--color-base-text-1), 0.5);
    font-size: 1.2rem;
  }

  .collection__filter-price-inputs {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .collection__filter-price-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .collection__filter-price-field label {
    font-size: 1.2rem;
    color: rgba(var(--color-base-text-1), 0.6);
  }

  .collection__filter-price-input {
    width: 100%;
    padding: 0.8rem;
    font-size: 1.4rem;
    font-family: var(--font-body-family);
    border: 1.5px solid rgba(var(--color-base-text-1), 0.3);
    border-radius: var(--inputs-radius);
    background: transparent;
    color: rgb(var(--color-base-text-1));
  }

  .collection__filter-price-separator {
    font-size: 1.4rem;
    color: rgba(var(--color-base-text-1), 0.4);
    margin-top: 2rem;
  }

  .collection__filter-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }

  .collection__filter-clear {
    font-size: 1.4rem;
    color: rgba(var(--color-base-text-1), 0.6);
    text-align: center;
    text-decoration: underline;
  }

  .collection__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 2.4rem;
  }

  .product-card__unit-price {
    font-size: 1.2rem;
    color: rgba(var(--color-base-text-1), 0.55);
    margin-top: 0.4rem;
  }

  .collection__pagination {
    margin-top: 4rem;
    display: flex;
    justify-content: center;
  }

  .collection__pagination .pagination {
    display: flex;
    gap: 0.8rem;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  .collection__pagination .pagination a,
  .collection__pagination .pagination span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 4rem;
    height: 4rem;
    padding: 0 1.2rem;
    font-size: 1.4rem;
    border: 1.5px solid rgba(var(--color-base-text-1), 0.2);
    border-radius: var(--buttons-radius);
    color: rgb(var(--color-base-text-1));
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }

  .collection__pagination .pagination a:hover {
    background: rgba(var(--color-base-text-1), 0.05);
    border-color: rgba(var(--color-base-text-1), 0.4);
    text-decoration: none;
  }

  .collection__pagination .pagination .current {
    background: rgb(var(--color-base-accent-1));
    border-color: rgb(var(--color-base-accent-1));
    color: rgb(var(--color-base-background-1));
  }

  .collection__empty {
    text-align: center;
    padding: 8rem 2rem;
  }

  .collection__empty-title { margin-bottom: 1.2rem; }

  .collection__empty-text {
    font-size: 1.5rem;
    color: rgba(var(--color-base-text-1), 0.7);
    margin-bottom: 2.4rem;
  }

  .collection__products.is-loading {
    opacity: 0.5;
    pointer-events: none;
    position: relative;
  }

  .collection__products.is-loading::after {
    content: '';
    position: absolute;
    top: 4rem;
    left: 50%;
    width: 3rem;
    height: 3rem;
    margin-left: -1.5rem;
    border: 2px solid rgba(var(--color-base-text-1), 0.15);
    border-top-color: rgb(var(--color-base-accent-1));
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  @media (max-width: 990px) {
    .collection__grid { grid-template-columns: repeat(2, 1fr); }
    .collection__layout--with-filters { grid-template-columns: 1fr; }
    .collection__filters {
      position: fixed;
      inset: 0;
      z-index: 200;
      border-radius: 0;
      overflow-y: auto;
    }
  }

  @media (max-width: 576px) {
    .collection__grid { grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  }
</style>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true,
      "info": "Customize filters with the Search & Discovery app"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 12
    }
  ]
}
{% endschema %}