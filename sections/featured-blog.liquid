{%- assign blog = blogs[section.settings.blog] -%}

<section class="featured-blog section-spacing" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="featured-blog__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="featured-blog__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.show_view_all and blog != blank -%}
        <a href="{{ blog.url }}" class="featured-blog__view-all">{{ 'blogs.view_all' | t }}</a>
      {%- endif -%}
    </div>

    <ul class="featured-blog__grid list-unstyled" role="list">
      {%- if blog != blank and blog.articles.size > 0 -%}
        {%- for article in blog.articles limit: section.settings.posts_to_show -%}
          <li class="featured-blog__item">
            <article class="featured-blog__card">
              {%- if article.image -%}
                <a href="{{ article.url }}" class="featured-blog__media">
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 33vw, 100vw',
                      widths: '375, 550, 750, 800',
                      class: 'featured-blog__image',
                      alt: article.image.alt | default: article.title | escape
                  }}
                </a>
              {%- endif -%}
              <div class="featured-blog__content">
                <time class="featured-blog__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: format: 'date' }}
                </time>
                <h3 class="featured-blog__title">
                  <a href="{{ article.url }}">{{ article.title }}</a>
                </h3>
                {%- if article.excerpt.size > 0 -%}
                  <p class="featured-blog__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
                {%- endif -%}
                <a href="{{ article.url }}" class="featured-blog__read-more">{{ 'blogs.read_more' | t }}</a>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="featured-blog__item">
            <article class="featured-blog__card featured-blog__card--placeholder">
              <div class="featured-blog__media">
                {{ 'lifestyle-' | append: i | placeholder_svg_tag: 'featured-blog__placeholder' }}
              </div>
              <div class="featured-blog__content">
                <span class="featured-blog__date">{{ 'now' | date: format: 'date' }}</span>
                <h3 class="featured-blog__title"><a href="#">Blog post title</a></h3>
                <p class="featured-blog__excerpt">Give your customers a summary of your blog post.</p>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

<style>
  .featured-blog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .featured-blog__heading {
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    margin: 0;
  }

  .featured-blog__view-all {
    font-size: 1.4rem;
    font-weight: var(--font-body-weight-bold);
    color: rgb(var(--color-base-accent-1));
    text-decoration: underline;
    white-space: nowrap;
  }

  .featured-blog__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 2.4rem;
  }

  .featured-blog__card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .featured-blog__media {
    display: block;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: rgb(var(--color-base-background-2));
    margin-bottom: 1.6rem;
  }

  .featured-blog__image,
  .featured-blog__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .featured-blog__card:hover .featured-blog__image {
    transform: scale(1.04);
  }

  .featured-blog__date {
    font-size: 1.2rem;
    color: rgba(var(--color-base-text-1), 0.55);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .featured-blog__title {
    font-size: 1.8rem;
    margin: 0.6rem 0 0.8rem;
  }

  .featured-blog__title a {
    color: rgb(var(--color-base-text-1));
    text-decoration: none;
  }

  .featured-blog__title a:hover {
    color: rgb(var(--color-base-accent-1));
  }

  .featured-blog__excerpt {
    font-size: 1.4rem;
    color: rgba(var(--color-base-text-1), 0.7);
    line-height: 1.6;
    margin: 0 0 1.2rem;
    flex: 1;
  }

  .featured-blog__read-more {
    font-size: 1.4rem;
    font-weight: var(--font-body-weight-bold);
    color: rgb(var(--color-base-accent-1));
    text-decoration: underline;
  }

  @media (max-width: 990px) {
    .featured-blog__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 576px) {
    .featured-blog__grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Featured blog",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Posts to show",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured blog"
    }
  ]
}
{% endschema %}
