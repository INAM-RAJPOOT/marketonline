<section
  class="complementary section-spacing"
  id="shopify-section-{{ section.id }}"
  data-complementary
  data-product-id="{{ product.id }}"
  data-limit="{{ section.settings.products_to_show }}"
  data-heading="{{ section.settings.heading | escape }}"
  hidden
>
  <div class="page-width">
    <h2 class="complementary__heading">{{ section.settings.heading }}</h2>
    <ul class="complementary__grid list-unstyled" role="list" data-complementary-grid></ul>
  </div>
</section>

{% schema %}
{
  "name": "Cross-selling",
  "tag": "section",
  "class": "section-complementary",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently bought together"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Cross-selling"
    }
  ]
}
{% endschema %}
