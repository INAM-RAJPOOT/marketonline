<section class="trust-badges section-spacing color-scheme-{{ section.settings.color_scheme }}" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="trust-badges__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul class="trust-badges__grid list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="trust-badges__item" {{ block.shopify_attributes }}>
          <div class="trust-badges__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'shipping' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
              {%- when 'secure' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              {%- when 'returns' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                </svg>
              {%- when 'support' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
              {%- when 'quality' -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
            {%- endcase -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="trust-badges__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="trust-badges__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .trust-badges__heading {
    text-align: center;
    font-size: clamp(2rem, 3vw, 2.8rem);
    margin: 0 0 4rem;
  }

  .trust-badges__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 3rem 2.4rem;
  }

  .trust-badges__item {
    text-align: center;
  }

  .trust-badges__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 6.4rem;
    height: 6.4rem;
    margin-bottom: 1.6rem;
    border-radius: 50%;
    background: rgba(var(--color-base-accent-1), 0.1);
    color: rgb(var(--color-base-accent-1));
  }

  .trust-badges__title {
    font-size: 1.6rem;
    margin: 0 0 0.8rem;
  }

  .trust-badges__text {
    font-size: 1.4rem;
    line-height: 1.6;
    color: rgba(var(--color-base-text-1), 0.75);
    margin: 0;
    max-width: 28rem;
    margin-inline: auto;
  }

  @media (max-width: 990px) {
    .trust-badges__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 576px) {
    .trust-badges__grid { grid-template-columns: 1fr; gap: 2.4rem; }
  }
</style>

{% schema %}
{
  "name": "Trust badges",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why customers choose us"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "1", "label": "Scheme 1" },
        { "value": "2", "label": "Scheme 2" },
        { "value": "3", "label": "Scheme 3" },
        { "value": "4", "label": "Scheme 4" }
      ],
      "default": "2"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "secure", "label": "Secure checkout" },
            { "value": "returns", "label": "Easy returns" },
            { "value": "support", "label": "Support" },
            { "value": "quality", "label": "Quality" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "On all orders over $75"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "shipping", "title": "Free shipping", "text": "On all orders over $75" } },
        { "type": "badge", "settings": { "icon": "returns", "title": "Easy returns", "text": "30-day hassle-free returns" } },
        { "type": "badge", "settings": { "icon": "secure", "title": "Secure checkout", "text": "100% protected payments" } },
        { "type": "badge", "settings": { "icon": "support", "title": "Expert support", "text": "We're here to help 7 days a week" } }
      ]
    }
  ]
}
{% endschema %}
