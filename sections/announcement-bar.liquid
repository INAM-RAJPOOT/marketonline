{%- if section.settings.text != blank -%}
  <div
    class="announcement-bar color-scheme-{{ section.settings.color_scheme }}"
    role="region"
    aria-label="Announcement"
  >
    <div class="announcement-bar__inner page-width">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-bar__link">
          {{ section.settings.text }}
          {%- if section.settings.show_arrow -%}
            <span class="announcement-bar__arrow" aria-hidden="true">&rarr;</span>
          {%- endif -%}
        </a>
      {%- else -%}
        <p class="announcement-bar__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<style>
  .announcement-bar {
    padding: 1rem 0;
    text-align: center;
    font-size: 1.3rem;
    font-weight: var(--font-body-weight-bold);
    letter-spacing: 0.04em;
  }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .announcement-bar__link,
  .announcement-bar__text {
    margin: 0;
    color: inherit;
    text-decoration: none;
  }

  .announcement-bar__link:hover {
    opacity: 0.85;
    text-decoration: underline;
  }

  .announcement-bar__arrow {
    margin-left: 0.6rem;
    display: inline-block;
    transition: transform 0.2s;
  }

  .announcement-bar__link:hover .announcement-bar__arrow {
    transform: translateX(3px);
  }
</style>

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free shipping on orders over $75 — Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow on link",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "1", "label": "Scheme 1" },
        { "value": "2", "label": "Scheme 2" },
        { "value": "3", "label": "Scheme 3" },
        { "value": "4", "label": "Scheme 4" }
      ],
      "default": "3"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
