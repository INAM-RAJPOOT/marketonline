<section class="promo-tiles section-spacing" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="promo-tiles__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ul class="promo-tiles__grid list-unstyled" role="list" style="--columns: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <li class="promo-tile" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="promo-tile__link">
            <div class="promo-tile__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 1000, 1200',
                    sizes: '(min-width: 990px) 33vw, 100vw',
                    class: 'promo-tile__image',
                    alt: block.settings.image.alt | default: block.settings.heading | escape
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'promo-tile__placeholder' }}
              {%- endif -%}
              {%- if block.settings.badge != blank -%}
                <span class="promo-tile__badge">{{ block.settings.badge }}</span>
              {%- endif -%}
            </div>
            <div class="promo-tile__content">
              {%- if block.settings.heading != blank -%}
                <h3 class="promo-tile__title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="promo-tile__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Promo tiles",
  "tag": "section",
  "class": "section-promo-tiles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This week's offers"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Promo tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Sale"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Promo title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Add a short offer next to your products."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo tiles",
      "blocks": [
        { "type": "tile", "settings": { "badge": "New", "heading": "Just dropped", "text": "Shop the latest arrivals." } },
        { "type": "tile", "settings": { "badge": "Sale", "heading": "Up to 40% off", "text": "Seasonal styles, limited time." } },
        { "type": "tile", "settings": { "badge": "Bundle", "heading": "Buy more, save more", "text": "Volume pricing on selected lines." } }
      ]
    }
  ]
}
{% endschema %}
