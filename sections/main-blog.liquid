{%- paginate blog.articles by section.settings.articles_per_page -%}
<section class="blog section-spacing" id="shopify-section-{{ section.id }}">
  <div class="page-width">

    <div class="blog__header">
      <h1 class="blog__title">{{ blog.title }}</h1>
    </div>

    <ul class="blog__grid list-unstyled" role="list">
      {%- for article in blog.articles -%}
        <li class="blog__item">
          <article class="article-card">
            {%- if article.image -%}
              <a href="{{ article.url }}" class="article-card__media-link" aria-label="{{ article.title | escape }}">
                <div class="article-card__media">
                  <img
                    src="{{ article.image | image_url: width: 800 }}"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    width="800"
                    height="500"
                    loading="lazy"
                    class="article-card__image"
                  >
                </div>
              </a>
            {%- endif -%}
            <div class="article-card__info">
              <div class="article-card__meta">
                <span class="article-card__date">{{ article.published_at | date: '%B %d, %Y' }}</span>
                {%- if article.author != blank -%}
                  <span class="article-card__author">by {{ article.author }}</span>
                {%- endif -%}
              </div>
              <h2 class="article-card__title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h2>
              {%- if article.excerpt != blank -%}
                <p class="article-card__excerpt">{{ article.excerpt | strip_html | truncate: 150 }}</p>
              {%- endif -%}
              <a href="{{ article.url }}" class="article-card__read-more">Read more</a>
            </div>
          </article>
        </li>
      {%- endfor -%}
    </ul>

    {%- if paginate.pages > 1 -%}
      <nav class="blog__pagination" aria-label="Blog pagination">
        {{ paginate | default_pagination }}
      </nav>
    {%- endif -%}

  </div>
</section>
{%- endpaginate -%}

<style>
  .blog__header { margin-bottom: 4rem; }
  .blog__title { font-size: clamp(2.8rem, 4vw, 4.8rem); margin: 0; }

  .blog__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: 3.2rem;
  }

  .article-card { display: flex; flex-direction: column; height: 100%; }

  .article-card__media {
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: rgb(var(--color-base-background-2));
    margin-bottom: 2rem;
  }

  .article-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .article-card__media-link:hover .article-card__image { transform: scale(1.04); }

  .article-card__meta {
    display: flex;
    gap: 1rem;
    font-size: 1.3rem;
    color: rgba(var(--color-base-text-1), 0.55);
    margin-bottom: 1rem;
  }

  .article-card__title {
    font-size: 2rem;
    margin: 0 0 1rem;
    line-height: 1.3;
  }

  .article-card__title a {
    color: rgb(var(--color-base-text-1));
    text-decoration: none;
  }

  .article-card__title a:hover { text-decoration: underline; }

  .article-card__excerpt {
    font-size: 1.4rem;
    line-height: 1.6;
    color: rgba(var(--color-base-text-1), 0.75);
    margin-bottom: 1.6rem;
  }

  .article-card__read-more {
    font-size: 1.4rem;
    font-weight: var(--font-body-weight-bold);
    color: rgb(var(--color-base-accent-1));
    text-decoration: underline;
    margin-top: auto;
  }

  .blog__pagination {
    margin-top: 4rem;
    display: flex;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .blog__grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 12,
      "step": 3,
      "label": "Articles per page",
      "default": 6
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns",
      "default": 3
    }
  ]
}
{% endschema %}