<footer class="footer" role="contentinfo">
  <div class="footer__main page-width">

    {%- comment -%} Logo & About {%- endcomment -%}
    <div class="footer__brand">
      {%- if settings.logo != blank -%}
        <img
          src="{{ settings.logo | image_url: width: 140 }}"
          alt="{{ settings.logo.alt | default: shop.name | escape }}"
          width="140"
          height="auto"
          loading="lazy"
        >
      {%- else -%}
        <span class="footer__shop-name">{{ shop.name }}</span>
      {%- endif -%}

      {%- if section.settings.about_text != blank -%}
        <p class="footer__about">{{ section.settings.about_text }}</p>
      {%- endif -%}

      {%- comment -%} Social Icons {%- endcomment -%}
      {%- if settings.social_instagram_link != blank
        or settings.social_facebook_link != blank
        or settings.social_twitter_link != blank
        or settings.social_pinterest_link != blank
        or settings.social_tiktok_link != blank
        or settings.social_youtube_link != blank -%}
        <ul class="footer__social list-unstyled" aria-label="Social media links">
          {%- if settings.social_instagram_link != blank -%}
            <li>
              <a href="{{ settings.social_instagram_link }}" target="_blank" rel="nofollow noopener" aria-label="Instagram">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <li>
              <a href="{{ settings.social_facebook_link }}" target="_blank" rel="nofollow noopener" aria-label="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <li>
              <a href="{{ settings.social_twitter_link }}" target="_blank" rel="nofollow noopener" aria-label="X (Twitter)">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.258 5.625 5.906-5.625zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}
            <li>
              <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="nofollow noopener" aria-label="Pinterest">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
                </svg>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <li>
              <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="nofollow noopener" aria-label="TikTok">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                </svg>
              </a>
            </li>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <li>
              <a href="{{ settings.social_youtube_link }}" target="_blank" rel="nofollow noopener" aria-label="YouTube">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/>
                </svg>
              </a>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} Footer Menu Columns {%- endcomment -%}
    {%- for i in (1..3) -%}
      {%- liquid
        case i
          when 1
            assign menu_id = section.settings.footer_menu_1
            assign menu_heading = section.settings.footer_heading_1
          when 2
            assign menu_id = section.settings.footer_menu_2
            assign menu_heading = section.settings.footer_heading_2
          when 3
            assign menu_id = section.settings.footer_menu_3
            assign menu_heading = section.settings.footer_heading_3
        endcase
      -%}
      {%- if linklists[menu_id].links.size > 0 -%}
        <div class="footer__column">
          {%- if menu_heading != blank -%}
            <p class="footer__column-heading">{{ menu_heading }}</p>
          {%- endif -%}
          <ul class="footer__column-list list-unstyled" role="list">
            {%- for link in linklists[menu_id].links -%}
              <li>
                <a href="{{ link.url }}" class="footer__column-link">{{ link.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}

  </div>

  {%- comment -%} Footer Bottom Bar {%- endcomment -%}
  <div class="footer__bottom">
    <div class="footer__bottom-inner page-width">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}, {{ shop.name }}
        {%- if section.settings.show_powered_by -%}
          . Powered by
          <a href="https://www.shopify.com" rel="nofollow" target="_blank">Shopify</a>
        {%- endif -%}
      </p>
      {%- if section.settings.footer_bottom_menu != blank -%}
        <ul class="footer__bottom-nav list-unstyled" role="list">
          {%- for link in linklists[section.settings.footer_bottom_menu].links -%}
            <li>
              <a href="{{ link.url }}" class="footer__bottom-link">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

</footer>

<style>
  .footer {
    background-color: rgb(var(--color-base-background-3));
    color: rgb(var(--color-base-text-3));
    margin-top: var(--spacing-sections);
  }

  .footer a {
    color: rgb(var(--color-base-text-3));
  }

  .footer__main {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 4rem;
    padding-top: 6rem;
    padding-bottom: 4rem;
  }

  .footer__shop-name {
    font-family: var(--font-heading-family);
    font-size: 2rem;
    font-weight: var(--font-heading-weight);
    display: block;
    margin-bottom: 1.5rem;
  }

  .footer__about {
    font-size: 1.4rem;
    line-height: 1.6;
    opacity: 0.8;
    margin: 1.5rem 0;
    max-width: 28rem;
  }

  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .footer__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    color: rgb(var(--color-base-text-3));
    border: 1px solid rgba(var(--color-base-text-3), 0.35);
    border-radius: 50%;
    transition: background 0.2s, color 0.2s;
    text-decoration: none;
  }

  .footer__social a:hover {
    background: rgb(var(--color-base-accent-1));
    color: rgb(var(--color-base-background-1));
    border-color: rgb(var(--color-base-accent-1));
    text-decoration: none;
  }

  .footer__column-heading {
    font-family: var(--font-heading-family);
    font-size: 1.4rem;
    font-weight: var(--font-body-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.6rem;
    color: rgb(var(--color-base-text-3));
  }

  .footer__column-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__column-link {
    font-size: 1.4rem;
    color: rgba(var(--color-base-text-3), 0.75);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__column-link:hover {
    color: rgb(var(--color-base-text-3));
    text-decoration: none;
  }

  .footer__bottom {
    border-top: 1px solid rgba(var(--color-base-text-3), 0.2);
    padding: 2rem 0;
  }

  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer__bottom-inner .footer__copyright {
    flex: 1;
    min-width: 20rem;
  }

  .footer__copyright {
    font-size: 1.3rem;
    opacity: 0.7;
    margin: 0;
  }

  .footer__copyright a {
    color: inherit;
    text-decoration: underline;
  }

  .footer__bottom-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer__bottom-link {
    font-size: 1.3rem;
    color: rgba(var(--color-base-text-3), 0.75);
    text-decoration: none;
  }

  .footer__bottom-link:hover {
    color: rgb(var(--color-base-text-3));
    text-decoration: none;
  }

  @media (max-width: 990px) {
    .footer__main {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: span 2;
    }
  }

  @media (max-width: 576px) {
    .footer__main {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 4rem;
    }
    .footer__brand {
      grid-column: span 1;
    }
    .footer__bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "about_text",
      "label": "About text",
      "default": "Your store description goes here."
    },
    {
      "type": "header",
      "content": "Menu columns"
    },
    {
      "type": "text",
      "id": "footer_heading_1",
      "label": "Column 1 heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "footer_menu_1",
      "label": "Column 1 menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "footer_heading_2",
      "label": "Column 2 heading",
      "default": "Information"
    },
    {
      "type": "link_list",
      "id": "footer_menu_2",
      "label": "Column 2 menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "footer_heading_3",
      "label": "Column 3 heading",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "footer_menu_3",
      "label": "Column 3 menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "link_list",
      "id": "footer_bottom_menu",
      "label": "Bottom menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show Powered by Shopify",
      "default": true
    }
  ]
}
{% endschema %}