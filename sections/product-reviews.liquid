{%- liquid
  assign rating = product.metafields.reviews.rating.value | plus: 0
  assign rating_count = product.metafields.reviews.rating_count.value | plus: 0
  assign review_entries = product.metafields.reviews.reviews.value | default: product.metafields.custom.reviews.value
  assign has_summary = false
  if rating > 0 and rating_count > 0
    assign has_summary = true
  endif
  assign has_app_blocks = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app_blocks = true
    endif
  endfor
-%}

<section
  class="product-reviews section-spacing"
  id="product-reviews"
  data-product-reviews
>
  <div class="page-width">
    <div class="product-reviews__header">
      <h2 class="product-reviews__heading">{{ section.settings.heading }}</h2>
      {%- if has_summary and settings.reviews_provider == 'standard' -%}
        <div class="product-reviews__summary">
          {% render 'product-rating', product: product, size: 'lg', show_count: true %}
          <p class="product-reviews__average">{{ 'reviews.average' | t: rating: rating }}</p>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Judge.me full review widget {%- endcomment -%}
    {%- if settings.reviews_provider == 'judgeme' -%}
      <div class="product-reviews__judgeme">
        {% render 'judgeme-reviews', product: product %}
      </div>
    {%- endif -%}

    {%- comment -%} App blocks (Loox, Yotpo, etc.) {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="product-reviews__app" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} Native reviews from Shopify standard metaobjects {%- endcomment -%}
    {%- if settings.reviews_provider == 'standard' and review_entries != blank -%}
      <ul class="product-reviews__list list-unstyled" role="list">
        {%- for review in review_entries -%}
          {%- liquid
            assign review_rating = review.rating.value | default: review.rating | plus: 0
            assign review_title = review.title.value | default: review.title
            assign review_body = review.body.value | default: review.body
            assign review_author = review.author.value | default: review.author
            assign review_date = review.created_at.value | default: review.created_at
          -%}
          <li class="product-reviews__item">
            <article class="product-reviews__card">
              <div class="product-reviews__item-header">
                {% render 'product-rating', rating: review_rating, count: 1, size: 'sm', show_count: false %}
                {%- if review_date != blank -%}
                  <time class="product-reviews__date" datetime="{{ review_date | date: '%Y-%m-%d' }}">
                    {{ review_date | date: format: 'date' }}
                  </time>
                {%- endif -%}
              </div>
              {%- if review_title != blank -%}
                <h3 class="product-reviews__item-title">{{ review_title }}</h3>
              {%- endif -%}
              {%- if review_body != blank -%}
                <div class="product-reviews__body rte">{{ review_body }}</div>
              {%- endif -%}
              {%- if review_author != blank -%}
                <p class="product-reviews__author">{{ 'reviews.by_author' | t: author: review_author }}</p>
              {%- endif -%}
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif settings.reviews_provider == 'standard' and has_app_blocks == false and has_summary == false -%}
      <div class="product-reviews__empty">
        <p class="product-reviews__empty-text">{{ 'reviews.empty' | t }}</p>
        {%- if section.settings.show_app_hint -%}
          <p class="product-reviews__hint">{{ 'reviews.app_hint' | t }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .product-reviews__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.6rem 3rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(var(--color-base-text-1), 0.12);
  }

  .product-reviews__heading {
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    margin: 0;
  }

  .product-reviews__summary {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .product-reviews__average {
    font-size: 1.4rem;
    color: rgba(var(--color-base-text-1), 0.65);
    margin: 0;
  }

  .product-reviews__list {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .product-reviews__card {
    padding: 2rem;
    border: 1px solid rgba(var(--color-base-text-1), 0.12);
    border-radius: 12px;
    background: rgb(var(--color-base-background-1));
  }

  .product-reviews__item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .product-reviews__item-title {
    font-size: 1.6rem;
    margin: 0 0 0.8rem;
  }

  .product-reviews__body {
    font-size: 1.5rem;
    line-height: 1.7;
    color: rgba(var(--color-base-text-1), 0.85);
    margin-bottom: 1rem;
  }

  .product-reviews__author {
    font-size: 1.3rem;
    font-weight: var(--font-body-weight-bold);
    color: rgba(var(--color-base-text-1), 0.6);
    margin: 0;
  }

  .product-reviews__date {
    font-size: 1.2rem;
    color: rgba(var(--color-base-text-1), 0.5);
    white-space: nowrap;
  }

  .product-reviews__empty {
    text-align: center;
    padding: 4rem 2rem;
    color: rgba(var(--color-base-text-1), 0.6);
  }

  .product-reviews__empty-text {
    font-size: 1.6rem;
    margin: 0 0 1rem;
  }

  .product-reviews__hint {
    font-size: 1.4rem;
    margin: 0;
    max-width: 48rem;
    margin-inline: auto;
    line-height: 1.6;
  }

  .product-reviews__app:empty {
    display: none;
  }
</style>

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "section-product-reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "checkbox",
      "id": "show_app_hint",
      "label": "Show hint when no reviews",
      "default": true,
      "info": "Suggests installing a reviews app from the Shopify App Store"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Product reviews"
    }
  ]
}
{% endschema %}
