<section class="testimonials section-spacing color-scheme-{{ section.settings.color_scheme }}" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="testimonials__header">
      {%- if section.settings.subheading != blank -%}
        <p class="testimonials__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <ul class="testimonials__grid list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="testimonials__item" {{ block.shopify_attributes }}>
          <blockquote class="testimonials__card">
            {%- if block.settings.rating > 0 -%}
              <div class="testimonials__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- for i in (1..5) -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="{% if i <= block.settings.rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="testimonials__quote">&ldquo;{{ block.settings.text }}&rdquo;</p>
            {%- endif -%}

            <footer class="testimonials__author">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 80
                  | image_tag:
                    loading: 'lazy',
                    width: 40,
                    height: 40,
                    class: 'testimonials__avatar',
                    alt: block.settings.author | escape
                }}
              {%- endif -%}
              <div>
                {%- if block.settings.author != blank -%}
                  <cite class="testimonials__name">{{ block.settings.author }}</cite>
                {%- endif -%}
                {%- if block.settings.role != blank -%}
                  <span class="testimonials__role">{{ block.settings.role }}</span>
                {%- endif -%}
              </div>
            </footer>
          </blockquote>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .testimonials__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .testimonials__subheading {
    font-size: 1.3rem;
    font-weight: var(--font-body-weight-bold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgb(var(--color-base-accent-1));
    margin: 0 0 1.2rem;
  }

  .testimonials__heading {
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    margin: 0;
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 2.4rem;
  }

  .testimonials__card {
    margin: 0;
    padding: 2.8rem;
    background: rgb(var(--color-base-background-1));
    border-radius: 12px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .testimonials__stars {
    display: flex;
    gap: 0.2rem;
    color: rgb(var(--color-base-accent-1));
    margin-bottom: 1.6rem;
  }

  .testimonials__quote {
    font-size: 1.6rem;
    line-height: 1.7;
    color: rgba(var(--color-base-text-1), 0.85);
    margin: 0 0 2rem;
    flex: 1;
    font-style: normal;
  }

  .testimonials__author {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    font-style: normal;
  }

  .testimonials__avatar {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .testimonials__name {
    display: block;
    font-size: 1.4rem;
    font-weight: var(--font-body-weight-bold);
    font-style: normal;
  }

  .testimonials__role {
    display: block;
    font-size: 1.3rem;
    color: rgba(var(--color-base-text-1), 0.6);
  }

  @media (max-width: 990px) {
    .testimonials__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 576px) {
    .testimonials__grid { grid-template-columns: 1fr; }
    .testimonials__card { padding: 2rem; }
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by thousands"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "1", "label": "Scheme 1" },
        { "value": "2", "label": "Scheme 2" },
        { "value": "3", "label": "Scheme 3" },
        { "value": "4", "label": "Scheme 4" }
      ],
      "default": "1"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Quote",
          "default": "Absolutely love the quality. Fast shipping and the product exceeded my expectations. Will definitely order again!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Author detail",
          "default": "Verified buyer"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "Absolutely love the quality. Fast shipping and the product exceeded my expectations. Will definitely order again!",
            "author": "Sarah M.",
            "role": "Verified buyer"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "Best online shopping experience I've had. The packaging was beautiful and the customer service team was incredibly helpful.",
            "author": "James T.",
            "role": "Verified buyer"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "I've tried many brands but nothing compares. Premium quality at a fair price — my go-to store now.",
            "author": "Emily R.",
            "role": "Verified buyer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
