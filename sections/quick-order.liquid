<section class="quick-order section-spacing" id="shopify-section-{{ section.id }}" data-quick-order>
  <div class="page-width">
    {% render 'breadcrumbs' %}
    <h1 class="quick-order__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="quick-order__intro rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
      <form class="quick-order__form" data-quick-order-form>
        <table class="quick-order__table">
          <thead>
            <tr>
              <th>{{ 'cart.product' | t }}</th>
              <th>{{ 'products.price_label' | t }}</th>
              <th>{{ 'cart.quantity' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
              {%- assign variant = product.selected_or_first_available_variant -%}
              <tr>
                <td>
                  <a href="{{ product.url }}" class="quick-order__product">
                    {%- if product.featured_image -%}
                      {{
                        product.featured_image
                        | image_url: width: 120
                        | image_tag: loading: 'lazy', alt: product.title, width: 56, height: 56
                      }}
                    {%- endif -%}
                    <span>
                      <strong>{{ product.title }}</strong>
                      {%- unless product.has_only_default_variant -%}
                        <small>{{ variant.title }}</small>
                      {%- endunless -%}
                    </span>
                  </a>
                </td>
                <td>{{ variant.price | money }}</td>
                <td>
                  <label class="visually-hidden" for="QuickQty-{{ variant.id }}">{{ 'cart.quantity_for' | t: product: product.title }}</label>
                  <input
                    type="number"
                    id="QuickQty-{{ variant.id }}"
                    min="0"
                    value="0"
                    {% if variant.quantity_rule.min %}data-min="{{ variant.quantity_rule.min }}"{% endif %}
                    {% if variant.quantity_rule.increment %}step="{{ variant.quantity_rule.increment }}"{% endif %}
                    data-quick-order-qty
                    data-variant-id="{{ variant.id }}"
                    {% unless variant.available %}disabled{% endunless %}
                  >
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
        <p class="quick-order__status" data-quick-order-status role="status"></p>
        <button type="submit" class="button button--primary">{{ 'quick_order.add_selected' | t }}</button>
      </form>
    {%- else -%}
      <p>{{ 'quick_order.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Quick order list",
  "tag": "section",
  "class": "section-quick-order",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quick order"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Enter quantities and add several products to the cart at once. Useful for bulk and B2B orders.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 50,
      "step": 1,
      "label": "Products to show",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Quick order list"
    }
  ]
}
{% endschema %}
