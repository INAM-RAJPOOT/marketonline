<section class="collection-list section-spacing" id="shopify-section-{{ section.id }}">
  <div class="page-width">

    <div class="collection-list__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="collection-list__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="collection-list__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <ul class="collection-list__grid list-unstyled" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign collection = block.settings.collection -%}
          <li class="collection-list__item" {{ block.shopify_attributes }}>
            <a href="{{ collection.url | default: '#' }}" class="collection-list__card">
              <div class="collection-list__media">
                {%- if collection.featured_image -%}
                  {{
                    collection.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 33vw, 50vw',
                      widths: '375, 550, 750, 800',
                      class: 'collection-list__image',
                      alt: collection.featured_image.alt | default: collection.title | escape
                  }}
                {%- else -%}
                  {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'collection-list__placeholder' }}
                {%- endif -%}
                <div class="collection-list__overlay">
                  <span class="collection-list__title">{{ collection.title | default: 'Collection' }}</span>
                  {%- if block.settings.show_product_count and collection != blank -%}
                    <span class="collection-list__count">{{ collection.products_count }} products</span>
                  {%- endif -%}
                </div>
              </div>
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="collection-list__item">
            <a href="#" class="collection-list__card">
              <div class="collection-list__media">
                {{ 'collection-' | append: i | placeholder_svg_tag: 'collection-list__placeholder' }}
                <div class="collection-list__overlay">
                  <span class="collection-list__title">Collection {{ i }}</span>
                </div>
              </div>
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

  </div>
</section>

<style>
  .collection-list__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .collection-list__heading {
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    margin: 0 0 1.2rem;
  }

  .collection-list__text {
    font-size: 1.6rem;
    color: rgba(var(--color-base-text-1), 0.75);
    margin: 0;
    max-width: 52rem;
    margin-inline: auto;
  }

  .collection-list__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 2rem;
  }

  .collection-list__card {
    display: block;
    text-decoration: none;
    border-radius: 12px;
    overflow: hidden;
  }

  .collection-list__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: rgb(var(--color-base-background-2));
  }

  .collection-list__image,
  .collection-list__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .collection-list__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 2.4rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65) 0%, transparent 60%);
    transition: background 0.3s;
  }

  .collection-list__title {
    font-size: 2rem;
    font-weight: var(--font-body-weight-bold);
    color: #ffffff;
    text-align: center;
  }

  .collection-list__count {
    font-size: 1.3rem;
    color: rgba(255, 255, 255, 0.8);
    margin-top: 0.4rem;
  }

  @media (hover: hover) {
    .collection-list__card:hover .collection-list__image,
    .collection-list__card:hover .collection-list__placeholder {
      transform: scale(1.06);
    }
    .collection-list__card:hover .collection-list__overlay {
      background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.1) 60%);
    }
  }

  @media (max-width: 990px) {
    .collection-list__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 576px) {
    .collection-list__grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Find exactly what you're looking for"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "checkbox",
          "id": "show_product_count",
          "label": "Show product count",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
