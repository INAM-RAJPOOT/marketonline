<section class="rich-text section-spacing" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="rich-text__inner rich-text__inner--{{ section.settings.text_alignment }}">
      {%- if section.settings.subheading != blank -%}
        <p class="rich-text__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rich-text__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rich-text__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button button--primary">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .rich-text__inner {
    max-width: 72rem;
    margin: 0 auto;
  }
  .rich-text__inner--left { margin: 0; }
  .rich-text__inner--center { text-align: center; margin: 0 auto; }
  .rich-text__inner--right { text-align: right; margin: 0 0 0 auto; }

  .rich-text__subheading {
    font-size: 1.3rem;
    font-weight: var(--font-body-weight-bold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgb(var(--color-base-accent-1));
    margin: 0 0 1.2rem;
  }

  .rich-text__heading {
    font-size: clamp(2.4rem, 4vw, 4rem);
    margin: 0 0 2rem;
  }

  .rich-text__text {
    font-size: 1.6rem;
    line-height: 1.7;
    color: rgba(var(--color-base-text-1), 0.85);
    margin-bottom: 2.4rem;
  }
</style>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why shop with us?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe in quality products, exceptional service, and a shopping experience that feels personal. Every item is carefully curated for those who value the best.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}