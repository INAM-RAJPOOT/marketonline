<section class="not-found section-spacing" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="not-found__inner">
      <p class="not-found__eyebrow">{{ '404.title' | t }}</p>
      <h1 class="not-found__title">{{ section.settings.heading }}</h1>
      <p class="not-found__text">{{ section.settings.subtext }}</p>
      <div class="not-found__actions">
        <a href="{{ routes.root_url }}" class="button button--primary">Go to homepage</a>
        <a href="{{ routes.all_products_collection_url }}" class="button button--secondary-dark">Browse products</a>
      </div>
      <form action="{{ routes.search_url }}" method="get" class="not-found__search" role="search">
        <label for="not-found-search" class="not-found__search-label">Or search for something:</label>
        <div class="not-found__search-wrapper">
          <input
            type="search"
            id="not-found-search"
            name="q"
            placeholder="Search..."
            class="not-found__search-input"
            aria-label="Search"
          >
          <button type="submit" class="button button--primary">Search</button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .not-found__inner {
    text-align: center;
    padding: 8rem 2rem;
    max-width: 60rem;
    margin: 0 auto;
  }

  .not-found__eyebrow {
    font-size: 8rem;
    font-weight: var(--font-heading-weight);
    font-family: var(--font-heading-family);
    color: rgba(var(--color-base-text-1), 0.1);
    line-height: 1;
    margin: 0 0 2rem;
  }

  .not-found__title {
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    margin: 0 0 1.6rem;
  }

  .not-found__text {
    font-size: 1.6rem;
    color: rgba(var(--color-base-text-1), 0.7);
    margin-bottom: 3.2rem;
  }

  .not-found__actions {
    display: flex;
    gap: 1.2rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 4rem;
  }

  .button--secondary-dark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.2rem 2.4rem;
    font-size: 1.5rem;
    font-family: var(--font-body-family);
    font-weight: var(--font-body-weight-bold);
    border: var(--buttons-border-width) solid rgba(var(--color-base-text-1), 0.3);
    border-radius: var(--buttons-radius);
    background: transparent;
    color: rgb(var(--color-base-text-1));
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s;
  }

  .button--secondary-dark:hover {
    background: rgba(var(--color-base-text-1), 0.05);
    text-decoration: none;
  }

  .not-found__search-label {
    display: block;
    font-size: 1.4rem;
    color: rgba(var(--color-base-text-1), 0.6);
    margin-bottom: 1.2rem;
  }

  .not-found__search-wrapper {
    display: flex;
    border: 1.5px solid rgba(var(--color-base-text-1), 0.25);
    border-radius: var(--inputs-radius);
    overflow: hidden;
    max-width: 40rem;
    margin: 0 auto;
  }

  .not-found__search-input {
    flex: 1;
    padding: 1.2rem 1.6rem;
    font-size: 1.4rem;
    font-family: var(--font-body-family);
    border: none;
    background: transparent;
    color: rgb(var(--color-base-text-1));
    outline: none;
  }

  .not-found__search-wrapper .button--primary { border-radius: 0; }
</style>

{% schema %}
{
  "name": "404",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page not found"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "The page you were looking for doesn't exist. Try searching or browsing our store."
    }
  ]
}
{% endschema %}