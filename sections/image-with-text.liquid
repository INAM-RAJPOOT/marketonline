<section class="image-with-text section-spacing color-scheme-{{ section.settings.color_scheme }}" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="image-with-text__grid image-with-text__grid--{{ section.settings.layout }}">

      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 50vw, 100vw',
              widths: '375, 550, 750, 1100, 1200',
              class: 'image-with-text__image',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        {%- else -%}
          <div class="image-with-text__placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'image-with-text__placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div class="image-with-text__content">
        {%- if section.settings.subheading != blank -%}
          <p class="image-with-text__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="image-with-text__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="image-with-text__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--primary">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<style>
  .image-with-text__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .image-with-text__grid--image-right .image-with-text__media {
    order: 2;
  }

  .image-with-text__media {
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 4 / 5;
    background: rgb(var(--color-base-background-2));
  }

  .image-with-text__image,
  .image-with-text__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .image-with-text__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-with-text__subheading {
    font-size: 1.3rem;
    font-weight: var(--font-body-weight-bold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgb(var(--color-base-accent-1));
    margin: 0 0 1.2rem;
  }

  .image-with-text__heading {
    font-size: clamp(2.4rem, 4vw, 4rem);
    margin: 0 0 2rem;
    line-height: 1.15;
  }

  .image-with-text__text {
    font-size: 1.6rem;
    line-height: 1.7;
    color: rgba(var(--color-base-text-1), 0.85);
    margin-bottom: 2.4rem;
  }

  @media (max-width: 990px) {
    .image-with-text__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .image-with-text__grid--image-right .image-with-text__media {
      order: 0;
    }
    .image-with-text__media {
      aspect-ratio: 16 / 10;
    }
  }
</style>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "image-left", "label": "Image left" },
        { "value": "image-right", "label": "Image right" }
      ],
      "default": "image-left"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "1", "label": "Scheme 1" },
        { "value": "2", "label": "Scheme 2" },
        { "value": "3", "label": "Scheme 3" },
        { "value": "4", "label": "Scheme 4" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Limited edition"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted for those who demand more"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every piece in our collection is designed with intention — premium materials, timeless style, and details that make the difference. Discover what sets us apart.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
