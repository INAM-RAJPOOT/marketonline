<section class="contact-form section-spacing" id="shopify-section-{{ section.id }}">
  <div class="page-width contact-form__inner">
    {% render 'breadcrumbs' %}
    <h1 class="contact-form__title">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="contact-form__intro rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'contact', class: 'contact-form__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="contact-form__success" role="status">{{ 'contact.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="contact-form__errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="contact-form__field">
        <label for="ContactName-{{ section.id }}">{{ 'contact.name' | t }}</label>
        <input type="text" id="ContactName-{{ section.id }}" name="contact[name]" autocomplete="name" required>
      </div>
      <div class="contact-form__field">
        <label for="ContactEmail-{{ section.id }}">{{ 'contact.email' | t }}</label>
        <input type="email" id="ContactEmail-{{ section.id }}" name="contact[email]" autocomplete="email" required>
      </div>
      <div class="contact-form__field">
        <label for="ContactPhone-{{ section.id }}">{{ 'contact.phone' | t }}</label>
        <input type="tel" id="ContactPhone-{{ section.id }}" name="contact[phone]" autocomplete="tel">
      </div>

      {%- for block in section.blocks -%}
        <div class="contact-form__field" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'text' -%}
              <label for="ContactField-{{ block.id }}">{{ block.settings.label }}</label>
              <input type="text" id="ContactField-{{ block.id }}" name="contact[{{ block.settings.label | handleize }}]">
            {%- when 'textarea' -%}
              <label for="ContactField-{{ block.id }}">{{ block.settings.label }}</label>
              <textarea id="ContactField-{{ block.id }}" name="contact[{{ block.settings.label | handleize }}]" rows="4"></textarea>
            {%- when 'dropdown' -%}
              <label for="ContactField-{{ block.id }}">{{ block.settings.label }}</label>
              <select id="ContactField-{{ block.id }}" name="contact[{{ block.settings.label | handleize }}]">
                {%- assign options = block.settings.options | split: ',' -%}
                {%- for option in options -%}
                  <option value="{{ option | strip | escape }}">{{ option | strip }}</option>
                {%- endfor -%}
              </select>
          {%- endcase -%}
        </div>
      {%- endfor -%}

      <div class="contact-form__field">
        <label for="ContactBody-{{ section.id }}">{{ 'contact.message' | t }}</label>
        <textarea id="ContactBody-{{ section.id }}" name="contact[body]" rows="6" required></textarea>
      </div>
      <button type="submit" class="button button--primary">{{ section.settings.button_label }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact us"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Send a message and we will get back to you.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Order number"
        }
      ]
    },
    {
      "type": "textarea",
      "name": "Text area",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Details"
        }
      ]
    },
    {
      "type": "dropdown",
      "name": "Dropdown",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Topic"
        },
        {
          "type": "text",
          "id": "options",
          "label": "Options",
          "info": "Separate choices with commas",
          "default": "Order, Product, Wholesale, Other"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "blocks": [
        { "type": "dropdown" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
