<div class="password" id="shopify-section-{{ section.id }}">
  <div class="password__inner">

    <div class="password__header">
      {%- if settings.logo != blank -%}
        <img
          src="{{ settings.logo | image_url: width: 200 }}"
          alt="{{ settings.logo.alt | default: shop.name | escape }}"
          width="200"
          height="auto"
          class="password__logo"
        >
      {%- else -%}
        <span class="password__shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </div>

    <div class="password__content">
      <h1 class="password__title">{{ section.settings.heading }}</h1>
      <p class="password__text">{{ section.settings.subtext }}</p>

      {%- form 'storefront_password', id: 'password-form' -%}
        {%- if form.errors -%}
          <p class="password__error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="password__form">
          <label for="password-input" class="visually-hidden">{{ 'password.password' | t }}</label>
          <input
            type="password"
            id="password-input"
            name="password"
            placeholder="{{ 'password.password' | t }}"
            class="password__input"
            required
            autocomplete="current-password"
          >
          <button type="submit" class="button button--primary">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </div>

    <footer class="password__footer">
      <p class="password__powered">
        Powered by <a href="https://www.shopify.com" rel="nofollow" target="_blank">Shopify</a>
      </p>
    </footer>

  </div>
</div>

<style>
  .password {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(var(--color-base-background-1));
    padding: 4rem 2rem;
  }

  .password__inner {
    width: 100%;
    max-width: 48rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .password__shop-name {
    font-family: var(--font-heading-family);
    font-size: 2.4rem;
    font-weight: var(--font-heading-weight);
    color: rgb(var(--color-base-text-1));
  }

  .password__logo { max-width: 16rem; height: auto; }

  .password__title {
    font-size: clamp(2.8rem, 5vw, 4rem);
    margin: 0 0 1.2rem;
  }

  .password__text {
    font-size: 1.6rem;
    color: rgba(var(--color-base-text-1), 0.7);
    line-height: 1.6;
    margin-bottom: 2.4rem;
  }

  .password__error {
    color: #CC0000;
    font-size: 1.4rem;
    margin-bottom: 1.6rem;
  }

  .password__form {
    display: flex;
    border: 1.5px solid rgba(var(--color-base-text-1), 0.25);
    border-radius: var(--inputs-radius);
    overflow: hidden;
  }

  .password__input {
    flex: 1;
    padding: 1.4rem 1.6rem;
    font-size: 1.5rem;
    font-family: var(--font-body-family);
    border: none;
    background: transparent;
    color: rgb(var(--color-base-text-1));
    outline: none;
  }

  .password__form .button--primary { border-radius: 0; white-space: nowrap; }

  .password__footer { font-size: 1.3rem; color: rgba(var(--color-base-text-1), 0.5); }

  .password__powered a { color: inherit; text-decoration: underline; }
</style>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "We're working hard to bring you something amazing. Enter the password to get early access."
    }
  ]
}
{% endschema %}