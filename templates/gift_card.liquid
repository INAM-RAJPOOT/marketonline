<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="">
    <title>{{ 'gift_card.card' | t }} &ndash; {{ shop.name }}</title>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <style>
      body {
        font-family: var(--font-body-family);
        background: rgb(var(--color-base-background-1));
        color: rgb(var(--color-base-text-1));
        margin: 0;
        padding: 2rem;
      }
      .gift-card {
        max-width: 48rem;
        margin: 4rem auto;
        text-align: center;
      }
      .gift-card__shop-name {
        font-family: var(--font-heading-family);
        font-size: 2rem;
        margin-bottom: 3rem;
        display: block;
      }
      .gift-card__header {
        background: rgb(var(--color-base-background-2));
        border-radius: 16px;
        padding: 3.2rem;
        margin-bottom: 2.4rem;
      }
      .gift-card__title {
        font-size: 3.2rem;
        margin: 0 0 0.8rem;
      }
      .gift-card__balance {
        font-size: 2rem;
        color: rgb(var(--color-base-accent-1));
        margin: 0 0 2.4rem;
      }
      .gift-card__qr {
        margin: 2.4rem auto;
      }
      .gift-card__qr img {
        width: 120px;
        height: 120px;
        display: block;
        margin: 0 auto;
      }
      .gift-card__code-label {
        font-size: 1.3rem;
        color: rgba(var(--color-base-text-1), 0.6);
        margin-bottom: 0.8rem;
        display: block;
      }
      .gift-card__code {
        font-size: 2rem;
        font-weight: bold;
        letter-spacing: 0.1em;
        padding: 1.2rem 2rem;
        background: rgb(var(--color-base-background-1));
        border: 1.5px solid rgba(var(--color-base-text-1), 0.2);
        border-radius: 8px;
        display: inline-block;
        margin-bottom: 1.6rem;
        user-select: all;
      }
      .gift-card__expiry {
        font-size: 1.3rem;
        color: rgba(var(--color-base-text-1), 0.55);
        margin-bottom: 0;
      }
      .gift-card__actions {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        margin-top: 2.4rem;
      }
      .gift-card__apple-wallet img { height: 40px; width: auto; }
      .gift-card__print {
        font-size: 1.4rem;
        color: rgba(var(--color-base-text-1), 0.6);
        text-decoration: underline;
        cursor: pointer;
        background: none;
        border: none;
        font-family: var(--font-body-family);
      }
      @media print {
        .gift-card__actions { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="gift-card">

      <a href="{{ shop.url }}" class="gift-card__shop-name">{{ shop.name }}</a>

      <div class="gift-card__header">
        <h1 class="gift-card__title">{{ 'gift_card.card' | t }}</h1>
        <p class="gift-card__balance">
          {%- if gift_card.balance != gift_card.initial_value -%}
            Remaining balance: {{ gift_card.balance | money }}
          {%- else -%}
            {{ gift_card.initial_value | money }}
          {%- endif -%}
        </p>

        <div class="gift-card__qr">
          {%- assign qr_size = 120 -%}
          <div
            class="gift-card__qr-code"
            data-identifier="{{ gift_card.qr_identifier }}"
            aria-label="{{ 'gift_card.qr_alt' | t: code: gift_card.code }}"
          ></div>
        </div>

        <span class="gift-card__code-label">Gift card code</span>
        <span class="gift-card__code">{{ gift_card.code | format_code }}</span>

        {%- if gift_card.expires_on -%}
          <p class="gift-card__expiry">
            {%- if gift_card.expired -%}
              {{ 'gift_card.expired' | t }}
            {%- else -%}
              {{ 'gift_card.expires_on' | t: expires_on: gift_card.expires_on | date: '%B %d, %Y' }}
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>

      <p>{{ 'gift_card.use_at_checkout' | t }}</p>

      <div class="gift-card__actions">
        {%- if gift_card.pass_url -%}
          <div class="gift-card__apple-wallet">
            <a href="{{ gift_card.pass_url }}">
              <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" alt="{{ 'gift_card.add_to_apple_wallet' | t }}" width="120" height="40">
            </a>
          </div>
        {%- endif -%}
        <button class="gift-card__print" onclick="window.print()">Print gift card</button>
      </div>

    </div>

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script defer>
      document.addEventListener('DOMContentLoaded', function () {
        var el = document.querySelector('.gift-card__qr-code');
        if (!el || typeof QRCode === 'undefined') return;
        new QRCode(el, {
          text: el.dataset.identifier,
          width: {{ qr_size }},
          height: {{ qr_size }}
        });
      });
    </script>
  </body>
</html>