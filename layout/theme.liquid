<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: number: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

<!-- Preconnect for performance -->
<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

<!-- Open Graph -->
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title }}">
<meta property="og:type" content="website">
<meta property="og:description" content="{{ page_description | default: shop.description | escape }}">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{%- endif -%}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title }}">
<meta name="twitter:description" content="{{ page_description | default: shop.description | escape }}">
{%- if page_image -%}
  <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- endif -%}

{% render 'structured-data' %}

    {%- if settings.type_header_font.system? == false -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endif -%}

    {%- if settings.type_primary_font.system? == false -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endif -%}

    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_primary_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_primary_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic'
      assign header_font_bold = settings.type_header_font | font_modify: 'weight', 'bold'
      assign header_font_italic = settings.type_header_font | font_modify: 'style', 'italic'
    -%}

    <style>
      {{ settings.type_primary_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      {{ header_font_bold | font_face: font_display: 'swap' }}
      {{ header_font_italic | font_face: font_display: 'swap' }}

      :root {
        --font-body-family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
        --font-body-style: {{ settings.type_primary_font.style }};
        --font-body-weight: {{ settings.type_primary_font.weight }};
        --font-body-weight-bold: {{ settings.type_primary_font.weight | plus: 300 | at_most: 1000 }};

        --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-style: {{ settings.type_header_font.style }};
        --font-heading-weight: {{ settings.type_header_font.weight }};

        --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 | times: settings.body_scale | divided_by: 100.0 }};

        --color-base-background-1: {{ settings.background_color.red }}, {{ settings.background_color.green }}, {{ settings.background_color.blue }};
        --color-base-background-2: {{ settings.background_color_2.red }}, {{ settings.background_color_2.green }}, {{ settings.background_color_2.blue }};
        --color-base-background-3: {{ settings.background_color_3.red }}, {{ settings.background_color_3.green }}, {{ settings.background_color_3.blue }};
        --color-base-background-4: {{ settings.background_color_4.red }}, {{ settings.background_color_4.green }}, {{ settings.background_color_4.blue }};

        --color-base-text-1: {{ settings.foreground_color.red }}, {{ settings.foreground_color.green }}, {{ settings.foreground_color.blue }};
        --color-base-text-2: {{ settings.foreground_color_2.red }}, {{ settings.foreground_color_2.green }}, {{ settings.foreground_color_2.blue }};
        --color-base-text-3: {{ settings.foreground_color_3.red }}, {{ settings.foreground_color_3.green }}, {{ settings.foreground_color_3.blue }};
        --color-base-text-4: {{ settings.foreground_color_4.red }}, {{ settings.foreground_color_4.green }}, {{ settings.foreground_color_4.blue }};

        --color-base-accent-1: {{ settings.accent_color_1.red }}, {{ settings.accent_color_1.green }}, {{ settings.accent_color_1.blue }};
        --color-base-accent-2: {{ settings.accent_color_2.red }}, {{ settings.accent_color_2.green }}, {{ settings.accent_color_2.blue }};
        --color-base-accent-3: {{ settings.accent_color_3.red }}, {{ settings.accent_color_3.green }}, {{ settings.accent_color_3.blue }};
        --color-base-accent-4: {{ settings.accent_color_4.red }}, {{ settings.accent_color_4.green }}, {{ settings.accent_color_4.blue }};

        --page-width: {{ settings.max_page_width }};
        --page-margin: {{ settings.min_page_margin }}px;
        --spacing-sections: {{ settings.spacing_sections }}px;

        --buttons-border-width: {{ settings.buttons_border_width }}px;
        --buttons-radius: {{ settings.buttons_radius }}px;
        --inputs-radius: {{ settings.input_corner_radius }}px;

        --logo-width: {{ settings.logo_width }}px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        font-size: calc(var(--font-body-scale) * 62.5%);
        height: 100%;
      }

      body {
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        grid-template-columns: 100%;
        min-height: 100%;
        margin: 0;
        font-size: 1.5rem;
        letter-spacing: 0.06rem;
        line-height: calc(1 + 0.8 / var(--font-body-scale));
        font-family: var(--font-body-family);
        font-style: var(--font-body-style);
        font-weight: var(--font-body-weight);
        color: rgb(var(--color-base-text-1));
        background-color: rgb(var(--color-base-background-1));
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-heading-family);
        font-style: var(--font-heading-style);
        font-weight: var(--font-heading-weight);
        letter-spacing: calc(var(--font-heading-scale) * 0.06rem);
        color: rgb(var(--color-base-text-1));
        line-height: calc(1 + 0.3 / var(--font-heading-scale));
        word-break: break-word;
      }

      h1 { font-size: calc(var(--font-heading-scale) * 4rem); }
      h2 { font-size: calc(var(--font-heading-scale) * 3.2rem); }
      h3 { font-size: calc(var(--font-heading-scale) * 2.4rem); }
      h4 { font-size: calc(var(--font-heading-scale) * 1.8rem); }
      h5 { font-size: calc(var(--font-heading-scale) * 1.6rem); }
      h6 { font-size: calc(var(--font-heading-scale) * 1.4rem); }

      a {
        color: rgb(var(--color-base-accent-1));
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .skip-to-content-link:focus {
        z-index: 9999;
        position: inherit;
        overflow: auto;
        width: auto;
        height: auto;
        clip: auto;
      }

      .page-width {
        max-width: var(--page-width);
        margin: 0 auto;
        padding: 0 var(--page-margin);
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- if template.directory == 'customers' -%}
      {{ 'customer.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    <script>
      window.theme = {
        moneyFormat: {{ shop.money_format | json }},
        routes: {
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          cart_url: '{{ routes.cart_url }}',
          search_url: '{{ routes.search_url }}',
          root: '{{ routes.root_url }}'
        },
        predictiveSearchEnabled: {{ settings.predictive_search_enabled | json }},
        wishlistEnabled: {{ settings.enable_wishlist | json }},
        wishlistUrl: {{ settings.wishlist_page.url | default: '/pages/wishlist' | json }},
        cartDrawer: {
          showUpsells: {{ settings.cart_drawer_show_upsells | json }},
          upsellsLimit: {{ settings.cart_drawer_upsells_limit | default: 3 }}
        },
        strings: {
          addToCart: {{ 'products.add_to_cart' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          sale: {{ 'products.sale' | t | json }},
          cartCount: {{ 'sections.header.cart_count' | t: count: '__COUNT__' | json }},
          error: {{ 'general.error' | t | json }},
          searchViewAll: {{ 'search.view_all' | t: terms: '__TERMS__' | json }},
          cartUpsellsHeading: {{ 'cart.upsells_heading' | t | json }},
          quickAdd: {{ 'products.quick_add' | t | json }},
          carouselSlide: {{ 'accessibility.carousel_slide' | t: current: '__CURRENT__', total: '__TOTAL__', title: '__TITLE__' | json }},
          loading: {{ 'accessibility.loading' | t | json }},
          wishlistAdd: {{ 'wishlist.add' | t | json }},
          wishlistRemove: {{ 'wishlist.remove' | t | json }},
          wishlistCount: {{ 'wishlist.count' | t: count: '__COUNT__' | json }}
        }
      };
      window.theme.strings.cartCount = window.theme.strings.cartCount.replace('__COUNT__', '{{ cart.item_count }}');
    </script>
  </head>

  <body>
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- sections 'header-group' -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- sections 'footer-group' -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {% render 'search-modal' %}
    {% render 'cart-drawer' %}
    {% render 'quick-add-modal' %}

    <script src="{{ 'global.js' | asset_url }}" defer></script>
  </body>
</html>